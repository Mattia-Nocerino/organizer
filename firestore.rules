rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ognuno legge e scrive solo i propri dati
    match /utenti/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /utenti/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
